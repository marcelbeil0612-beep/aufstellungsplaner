# FormaXI – Umgebungsvariablen für die Pro-Bezahlung (Paddle) + Lizenz.
# Kopiere diese Datei nach .env (lokal) bzw. trage die Werte in den
# Vercel-Project-Settings ein. .env ist gitignored – niemals committen.
#
# ── Client (Build-Zeit, MIT VITE_-Präfix → landet im Frontend; nur
#    nicht-geheime Werte!) ────────────────────────────────────────────
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_YEAR=
VITE_PADDLE_PRICE_MONTH=
VITE_PADDLE_PRICE_LIFETIME=
# Öffentlicher ECDSA-P-256-Schlüssel (Base64-SPKI) zur Offline-
# Verifikation der Lizenz. Wird per scripts/gen-license-keys.mjs erzeugt.
VITE_LICENSE_PUBLIC_KEY=
#
# ── Server (NUR Vercel-Function-Env, OHNE VITE_-Präfix → geheim) ──────
PADDLE_API_KEY=
PADDLE_API_ENV=sandbox
PADDLE_WEBHOOK_SECRET=
# Serverseitige Kopie der Preis-IDs (ohne VITE_) zum Plan-Mapping:
PADDLE_PRICE_YEAR=
PADDLE_PRICE_MONTH=
PADDLE_PRICE_LIFETIME=
# Privater ECDSA-P-256-Schlüssel (Base64-PKCS8), Gegenstück zu
# VITE_LICENSE_PUBLIC_KEY. Aus scripts/gen-license-keys.mjs.
LICENSE_PRIVATE_KEY=
